#!/usr/bin/make -f

# output every command that modifies files on the build system.
#DH_VERBOSE = 1

# see EXAMPLES in dpkg-buildflags(1) and read /usr/share/dpkg/*
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/default.mk

# The pkg.ksm-control-daemon.lsbservice build profile is for Devuan and other
# systemd-free Debian derivatives (see pve-common's and pve-manager's
# pkg.*.lsbservice profiles): it installs the LSB init script ksmtuned.init
# (adapted by init-script.diff and init-script-always-start.diff) instead of
# ksmtuned.service. To build this variant, run:
#   dpkg-buildpackage -b -us -uc -Ppkg.ksm-control-daemon.lsbservice
ifneq (,$(filter pkg.ksm-control-daemon.lsbservice,$(DEB_BUILD_PROFILES)))
LSBSERVICE = 1
endif

%:
	dh $@  --with quilt


destdir := $(CURDIR)/debian/ksm-control-daemon

override_dh_auto_install:
	install -D -m 0755 $(CURDIR)/ksmtuned $(destdir)/usr/sbin/ksmtuned
	install -D -m 0644 $(CURDIR)/ksmtuned.conf $(destdir)/etc/ksmtuned.conf

ifdef LSBSERVICE
execute_after_dh_auto_install:
	install -D -m 0755 $(CURDIR)/ksmtuned.init $(destdir)/etc/init.d/ksmtuned

override_dh_installinit:
	dh_installinit --name=ksmtuned --onlyscripts

override_dh_installsystemd:

execute_after_dh_lintian:
	install -d $(destdir)/usr/share/lintian/overrides
	cat debian/lintian-overrides.lsbservice \
	    >>$(destdir)/usr/share/lintian/overrides/ksm-control-daemon
else
override_dh_installsystemd:
	dh_installsystemd --name ksmtuned
endif
